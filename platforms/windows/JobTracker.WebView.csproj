<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <MinimumDesktopRuntimeVersion>10.0.13</MinimumDesktopRuntimeVersion>
    <RollForward>LatestPatch</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904;NU1900;NU1905</WarningsAsErrors>
    <AssemblyName>JobTrackerHost</AssemblyName>
    <ApplicationIcon>..\..\assets\icons\app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App.WindowsForms"
                        RuntimeFrameworkVersion="$(MinimumDesktopRuntimeVersion)" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4258.31]" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="[10.0.13]" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebViewWpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
